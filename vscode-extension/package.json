{
  "name": "mull",
  "displayName": "Mull",
  "version": "0.0.1",
  "description": "Organize your knowledge.",
  "categories": [
    "Programming Languages"
  ],
  "publisher": "stepchowfun",
  "type": "module",
  "main": "./src/extension.ts",
  "scripts": {
    "lint": "vp check",
    "format": "vp fmt"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "1.125.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "mull",
        "aliases": [
          "Mull",
          "mull"
        ],
        "extensions": [
          ".mull"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mull",
        "scopeName": "source.mull",
        "path": "./syntaxes/mull.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Mull",
      "properties": {
        "mull.executablePath": {
          "type": "string",
          "default": "mull",
          "scope": "machine-overridable",
          "description": "Path to the Mull executable used to start the language server."
        }
      }
    },
    "configurationDefaults": {
      "[mull]": {
        "editor.defaultFormatter": "stepchowfun.mull",
        "editor.formatOnSave": true,
        "editor.rulers": [
          80
        ],
        "editor.wordWrap": "bounded",
        "editor.wordWrapColumn": 80
      }
    }
  },
  "engines": {
    "vscode": "^1.128.0"
  }
}
