{
  "name": "mull",
  "displayName": "Mull",
  "version": "0.36.21",
  "description": "A tool for managing a wiki stored in a plain text file.",
  "categories": [
    "Programming Languages"
  ],
  "publisher": "stepchowfun",
  "type": "module",
  "main": "./src/extension.ts",
  "scripts": {
    "lint": "vp check",
    "format": "vp fmt"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/vscode": "1.125.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.0.0"
  },
  "contributes": {
    "languages": [
      {
        "id": "mull",
        "aliases": [
          "Mull",
          "mull"
        ],
        "extensions": [
          ".mull"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mull",
        "scopeName": "source.mull",
        "path": "./syntaxes/mull.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mull.goToNodeStart",
        "title": "Go to Start of Node",
        "category": "Mull"
      },
      {
        "command": "mull.goToNodeEnd",
        "title": "Go to End of Node",
        "category": "Mull"
      },
      {
        "command": "mull.selectToNodeStart",
        "title": "Select to Start of Node",
        "category": "Mull"
      },
      {
        "command": "mull.selectToNodeEnd",
        "title": "Select to End of Node",
        "category": "Mull"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "mull.goToNodeStart",
          "when": "editorLangId == mull"
        },
        {
          "command": "mull.goToNodeEnd",
          "when": "editorLangId == mull"
        },
        {
          "command": "mull.selectToNodeStart",
          "when": "editorLangId == mull"
        },
        {
          "command": "mull.selectToNodeEnd",
          "when": "editorLangId == mull"
        }
      ]
    },
    "keybindings": [
      {
        "command": "mull.goToNodeStart",
        "key": "ctrl+home",
        "mac": "cmd+up",
        "when": "editorTextFocus && editorLangId == mull"
      },
      {
        "command": "mull.goToNodeEnd",
        "key": "ctrl+end",
        "mac": "cmd+down",
        "when": "editorTextFocus && editorLangId == mull"
      },
      {
        "command": "mull.selectToNodeStart",
        "key": "shift+ctrl+home",
        "mac": "shift+cmd+up",
        "when": "editorTextFocus && editorLangId == mull"
      },
      {
        "command": "mull.selectToNodeEnd",
        "key": "shift+ctrl+end",
        "mac": "shift+cmd+down",
        "when": "editorTextFocus && editorLangId == mull"
      }
    ],
    "configuration": {
      "title": "Mull",
      "properties": {
        "mull.executablePath": {
          "type": "string",
          "default": "mull",
          "scope": "machine-overridable",
          "description": "Path to the Mull executable used to start the language server."
        },
        "mull.dimOtherNodes": {
          "type": "boolean",
          "default": true,
          "description": "Dim everything except the current node."
        },
        "mull.snapBackToCurrentNode": {
          "type": "boolean",
          "default": true,
          "description": "After scrolling past the current node, scroll back to it."
        }
      }
    },
    "configurationDefaults": {
      "[mull]": {
        "editor.defaultFormatter": "stepchowfun.mull",
        "editor.formatOnSave": true,
        "editor.glyphMargin": false,
        "editor.lineNumbers": "off",
        "editor.rulers": [
          80
        ],
        "editor.smoothScrolling": true,
        "editor.wordWrap": "bounded",
        "editor.wordWrapColumn": 80
      }
    }
  },
  "engines": {
    "vscode": "^1.128.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, Mull ignores the workspace's setting for its executable path, which could otherwise make the extension run any program.",
      "restrictedConfigurations": [
        "mull.executablePath"
      ]
    }
  }
}
