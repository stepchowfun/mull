{
  "name": "mull-example-scripts",
  "private": true,
  "description": "Checks for the scripts in the example wiki's file root, example_files/scripts.",
  "type": "module",
  "scripts": {
    "lint": "tsc && vp check . \"$(realpath ../example_files/scripts)\"",
    "format": "vp fmt . \"$(realpath ../example_files/scripts)\""
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@^1.0.0"
  }
}
