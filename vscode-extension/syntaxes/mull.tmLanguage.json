{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mull",
  "patterns": [
    {
      "include": "#titles"
    },
    {
      "include": "#secondary-headings"
    },
    {
      "include": "#fences"
    },
    {
      "include": "#text"
    }
  ],
  "repository": {
    "text": {
      "patterns": [
        {
          "include": "#code"
        },
        {
          "include": "#escapes"
        },
        {
          "include": "#closed-links"
        },
        {
          "include": "#unclosed-links"
        },
        {
          "name": "invalid.illegal.unexpected-closing-delimiter.mull",
          "match": "\\]"
        }
      ]
    },
    "code": {
      "patterns": [
        {
          "name": "markup.inline.raw.mull markup.raw.inline.mull",
          "match": "(`{1,2})(?!`).*?(?<!`)\\1(?!`)"
        },
        {
          "name": "markup.fenced_code.block.mull",
          "contentName": "markup.raw.block.mull",
          "begin": "(`{3,})",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.fenced_code.begin.mull"
            }
          },
          "end": "(?<!`)\\1(?!`)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.fenced_code.end.mull"
            }
          },
          "patterns": [
            {
              "include": "#code-languages"
            }
          ]
        },
        {
          "name": "invalid.illegal.unclosed-code.mull",
          "match": "`+"
        }
      ]
    },
    "code-languages": {
      "patterns": [
        {
          "contentName": "meta.embedded.block.bat.mull",
          "begin": "\\G(?i:bat|batch|cmd)[ \\t]*$",
          "while": "^(?!.*`{3})",
          "patterns": [
            {
              "include": "source.batchfile"
            }
          ]
        },
