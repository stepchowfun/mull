{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mull",
  "patterns": [
    {
      "include": "#titles"
    },
    {
      "include": "#secondary-headings"
    },
    {
      "include": "#text"
    }
  ],
  "repository": {
    "text": {
      "patterns": [
        {
          "include": "#code"
        },
        {
          "include": "#escapes"
        },
        {
          "include": "#links"
        },
        {
          "include": "#unexpected-closing-delimiters"
        }
      ]
    },
    "code": {
      "patterns": [
        {
          "name": "markup.inline.raw.mull",
          "match": "(`{1,2})(?!`).*?(?<!`)\\1(?!`)"
        },
        {
          "name": "markup.fenced_code.block.mull",
          "contentName": "markup.raw.block.mull",
          "begin": "(`{3,})",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.fenced_code.begin.mull"
            }
          },
          "end": "(?<!`)\\1(?!`)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.fenced_code.end.mull"
            }
          }
        },
        {
          "name": "invalid.illegal.unclosed-code.mull",
          "match": "`+"
        }
      ]
    },
    "titles": {
      "name": "markup.heading.1.mull",
      "match": "^(#) (.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.heading.mull"
        },
        "2": {
          "name": "entity.name.section.mull"
        }
      }
    },
    "secondary-headings": {
      "name": "markup.italic.heading.mull",
      "begin": "^(#{2,6})(?= |$)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.heading.mull"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#text"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mull",
          "match": "\\\\[\\\\\\[\\]`]"
        },
        {
          "name": "invalid.illegal.escape.mull",
          "match": "\\\\"
        }
      ]
    },
    "link-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mull",
          "match": "\\\\[\\\\\\[\\]]"
        },
        {
          "name": "invalid.illegal.escape.mull",
          "match": "\\\\"
        }
      ]
    },
    "links": {
      "patterns": [
        {
          "include": "#filesystem-links"
        },
        {
          "include": "#text-links"
        },
        {
          "include": "#unclosed-links"
        }
      ]
    },
    "filesystem-links": {
      "name": "meta.link.filesystem.mull",
      "contentName": "string.other.link.title.path.mull",
      "begin": "\\[(?=[ \\t]*/(?:[^\\\\\\]]|\\\\.)*\\])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.link.begin.mull"
        }
      },
      "end": "\\]|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.link.end.mull"
        }
      },
      "patterns": [
        {
          "include": "#link-contents"
        }
      ]
    },
    "text-links": {
      "name": "meta.link.text.mull",
      "contentName": "string.other.link.title.mull",
      "begin": "\\[(?=(?:[^\\\\\\]]|\\\\.)*\\])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.link.begin.mull"
        }
      },
      "end": "\\]|$",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.link.end.mull"
        }
      },
      "patterns": [
        {
          "include": "#link-contents"
        }
      ]
    },
    "unclosed-links": {
      "name": "meta.link.unclosed.mull",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "invalid.illegal.unclosed-link.mull"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#link-contents"
        }
      ]
    },
    "link-contents": {
      "patterns": [
        {
          "include": "#link-escapes"
        },
        {
          "name": "invalid.illegal.unexpected-opening-delimiter.mull",
          "match": "\\["
        }
      ]
    },
    "unexpected-closing-delimiters": {
      "name": "invalid.illegal.unexpected-closing-delimiter.mull",
      "match": "\\]"
    }
  },
  "scopeName": "source.mull"
}
