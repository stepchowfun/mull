            }
          ]
        },
        {
          "contentName": "meta.embedded.block.mull.mull",
          "begin": "\\G(?i:mull)[ \\t]*$",
          "while": "^(?!.*`{3})",
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "contentName": "meta.embedded.block.objective-c.mull",
          "begin": "\\G(?i:objective-c|objc|m)[ \\t]*$",
          "while": "^(?!.*`{3})",
