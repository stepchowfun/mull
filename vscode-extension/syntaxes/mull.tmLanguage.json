    },
    "titles": {
      "name": "markup.heading.1.mull",
      "match": "^(#) (.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.heading.mull"
        },
        "2": {
          "name": "entity.name.section.mull"
        }
      }
    },
    "secondary-headings": {
      "name": "markup.italic.heading.mull",
      "begin": "^(#{2,6})(?= |$)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.heading.mull"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#text"
        }
      ]
    },
    "fences": {
      "patterns": [
        {
          "name": "meta.block.mull",
          "match": "^[ \\t]*(:{3,})[ \\t]+([^ \\t#].*?)[ \\t]+(:{3,})[ \\t]*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.block.begin.mull"
            },
            "2": {
              "name": "punctuation.definition.block.begin.mull",
              "patterns": [
                {
                  "include": "#text"
                }
              ]
            },
            "3": {
              "name": "punctuation.definition.block.end.mull"
            }
          }
        },
        {
          "name": "meta.block.mull",
          "begin": "^[ \\t]*(:{3,})[ \\t]+([^ \\t#].*?)[ \\t]*$",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.block.begin.mull"
            },
            "2": {
              "name": "punctuation.definition.block.begin.mull",
              "patterns": [
                {
                  "include": "#text"
                }
              ]
            }
          },
          "end": "^[ \\t]*(\\1)(?:[ \\t]+(#[^ \\t]*))?[ \\t]*$|^(?=# )",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.block.end.mull"
            },
            "2": {
              "name": "punctuation.definition.block.end.mull"
            }
          },
          "patterns": [
            {
              "include": "#secondary-headings"
            },
            {
              "include": "#fences"
            },
            {
              "include": "#text"
            }
          ]
        },
        {
          "name": "invalid.illegal.fence.mull",
          "match": "^[ \\t]*:{3,}(?=[ \\t]|$).*$"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mull",
          "match": "\\\\[\\\\\\[\\]`]"
        },
        {
          "name": "invalid.illegal.escape.mull",
          "match": "\\\\"
        }
      ]
    },
    "link-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mull",
          "match": "\\\\[\\\\\\[\\]]"
        },
        {
          "name": "invalid.illegal.escape.mull",
          "match": "\\\\"
        }
      ]
    },
    "closed-links": {
      "name": "meta.link.closed.mull",
      "contentName": "string.other.link.title.mull",
      "begin": "\\[(?=(?:[^\\\\\\]]|\\\\.)*\\])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.link.begin.mull"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.link.end.mull"
        }
      },
      "patterns": [
        {
          "include": "#link-contents"
        }
      ]
    },
    "unclosed-links": {
      "name": "meta.link.unclosed.mull",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "invalid.illegal.unclosed-link.mull"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#link-contents"
        }
      ]
    },
    "link-contents": {
      "patterns": [
        {
          "include": "#link-escapes"
        },
        {
          "name": "invalid.illegal.unexpected-opening-delimiter.mull",
          "match": "\\["
        }
      ]
    }
  },
  "scopeName": "source.mull"
}
