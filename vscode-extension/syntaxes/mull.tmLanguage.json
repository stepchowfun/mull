{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mull",
  "patterns": [
    {
      "include": "#titles"
    },
    {
      "include": "#secondary-headings"
    },
    {
      "include": "#text"
    }
  ],
  "repository": {
    "text": {
      "patterns": [
        {
          "include": "#code"
        },
        {
          "include": "#escapes"
        },
        {
          "include": "#closed-links"
        },
        {
          "include": "#unclosed-links"
        },
        {
          "name": "invalid.illegal.unexpected-closing-delimiter.mull",
          "match": "\\]"
        }
      ]
    },
    "code": {
      "patterns": [
        {
          "name": "markup.inline.raw.mull",
          "match": "(`{1,2})(?!`).*?(?<!`)\\1(?!`)"
        },
        {
          "name": "markup.fenced_code.block.mull",
          "contentName": "markup.raw.block.mull",
          "begin": "(`{3,})",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.fenced_code.begin.mull"
            }
          },
          "end": "(?<!`)\\1(?!`)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.fenced_code.end.mull"
            }
          },
          "patterns": [
            {
              "include": "#embedded-code"
            }
          ]
        },
        {
          "name": "invalid.illegal.unclosed-code.mull",
          "match": "`+"
        }
      ]
    },
    "embedded-code": {
      "patterns": [
        {
          "contentName": "meta.embedded.block.yaml.mull",
          "begin": "\\G(?i:yaml|yml)[ \\t]*$",
          "while": "^(?!.*`{3})",
          "patterns": [
            {
              "include": "source.yaml"
            }
          ]
        },
        {
          "contentName": "meta.embedded.block.json.mull",
          "begin": "\\G(?i:json)[ \\t]*$",
          "while": "^(?!.*`{3})",
          "patterns": [
            {
              "include": "source.json"
            }
          ]
        },
        {
          "contentName": "meta.embedded.block.javascript.mull",
          "begin": "\\G(?i:javascript|js)[ \\t]*$",
          "while": "^(?!.*`{3})",
          "patterns": [
            {
              "include": "source.js"
            }
          ]
        },
        {
          "contentName": "meta.embedded.block.typescript.mull",
          "begin": "\\G(?i:typescript|ts)[ \\t]*$",
          "while": "^(?!.*`{3})",
          "patterns": [
            {
              "include": "source.ts"
            }
          ]
        },
        {
          "contentName": "meta.embedded.block.python.mull",
          "begin": "\\G(?i:python|py)[ \\t]*$",
          "while": "^(?!.*`{3})",
          "patterns": [
            {
              "include": "source.python"
            }
          ]
        },
        {
          "contentName": "meta.embedded.block.shellscript.mull",
          "begin": "\\G(?i:shell|sh|bash|zsh)[ \\t]*$",
          "while": "^(?!.*`{3})",
          "patterns": [
            {
              "include": "source.shell"
            }
          ]
        },
        {
          "contentName": "meta.embedded.block.rust.mull",
          "begin": "\\G(?i:rust|rs)[ \\t]*$",
          "while": "^(?!.*`{3})",
          "patterns": [
            {
              "include": "source.rust"
            }
          ]
        }
      ]
    },
    "titles": {
      "name": "markup.heading.1.mull",
      "match": "^(#) (.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.heading.mull"
        },
        "2": {
          "name": "entity.name.section.mull"
        }
      }
    },
    "secondary-headings": {
      "name": "markup.italic.heading.mull",
      "begin": "^(#{2,6})(?= |$)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.heading.mull"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#text"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mull",
          "match": "\\\\[\\\\\\[\\]`]"
        },
        {
          "name": "invalid.illegal.escape.mull",
          "match": "\\\\"
        }
      ]
    },
    "link-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.mull",
          "match": "\\\\[\\\\\\[\\]]"
        },
        {
          "name": "invalid.illegal.escape.mull",
          "match": "\\\\"
        }
      ]
    },
    "closed-links": {
      "name": "meta.link.closed.mull",
      "contentName": "string.other.link.title.mull",
      "begin": "\\[(?=(?:[^\\\\\\]]|\\\\.)*\\])",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.link.begin.mull"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.link.end.mull"
        }
      },
      "patterns": [
        {
          "include": "#link-contents"
        }
      ]
    },
    "unclosed-links": {
      "name": "meta.link.unclosed.mull",
      "begin": "\\[",
      "beginCaptures": {
        "0": {
          "name": "invalid.illegal.unclosed-link.mull"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "#link-contents"
        }
      ]
    },
    "link-contents": {
      "patterns": [
        {
          "include": "#link-escapes"
        },
        {
          "name": "invalid.illegal.unexpected-opening-delimiter.mull",
          "match": "\\["
        }
      ]
    }
  },
  "scopeName": "source.mull"
}
